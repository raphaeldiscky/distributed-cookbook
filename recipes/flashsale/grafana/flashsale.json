{
  "title": "Flashsale — Oversell Demo",
  "uid": "flashsale",
  "schemaVersion": 39,
  "timezone": "",
  "refresh": "5s",
  "time": { "from": "now-5m", "to": "now" },
  "tags": ["recipe", "flashsale"],
  "panels": [
    {
      "type": "stat",
      "title": "Oversell count (hero)",
      "id": 1,
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "sum(cookbook_flashsale_oversell_total)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Stock remaining",
      "id": 2,
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "min": -100,
          "max": 200,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "cookbook_flashsale_stock_remaining",
          "legendFormat": "product {{product_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Checkout RPS by outcome",
      "id": 3,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(cookbook_flashsale_checkout_attempts_total[30s])) by (adapter, outcome)",
          "legendFormat": "{{adapter}} / {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries",
      "title": "p50 latency per adapter",
      "id": 4,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(cookbook_flashsale_checkout_latency_seconds_bucket[30s])) by (le, adapter))",
          "legendFormat": "{{adapter}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "p95 latency per adapter",
      "id": 5,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(cookbook_flashsale_checkout_latency_seconds_bucket[30s])) by (le, adapter))",
          "legendFormat": "{{adapter}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "p99 latency per adapter",
      "id": 6,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(cookbook_flashsale_checkout_latency_seconds_bucket[30s])) by (le, adapter))",
          "legendFormat": "{{adapter}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "k6 client RPS",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(k6_http_reqs_total[30s]))",
          "refId": "A",
          "legendFormat": "k6 requests"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "logs",
      "title": "Logs (service=flashsale)",
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service=\"flashsale\"}",
          "refId": "A"
        }
      ],
      "options": { "showLabels": false, "showTime": true, "wrapLogMessage": true }
    }
  ]
}
