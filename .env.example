# Shared infrastructure connection settings (used by all recipes)
POSTGRES_DSN=postgres://cookbook:cookbook@localhost:5433/cookbook_db?sslmode=disable
REDIS_ADDR=localhost:6379
# Comma-separated. 9094 is the broker's host listener; containers use kafka:9092.
KAFKA_BROKERS=localhost:9094
OTLP_ENDPOINT=localhost:4318
LOG_LEVEL=info
# Set false when load testing without the collector up. A dead OTLP endpoint makes
# the exporter retry every batch, and those retries become what you measure.
TRACING_ENABLED=true

# ─── Recipe 1: flashsale ────────────────────────────────────────────────
# Adapter selection. Try them all:
#   naive         — racy read-check-write (demonstrates the bug)
#   pg_for_update — pessimistic row lock (correct, serializes)
#   pg_cond       — Postgres conditional UPDATE (correct)
#   pg_optimistic — version column plus bounded retry (correct, retries)
#   pg_bucketed   — stock split across K rows (correct, can undersell)
#   redis_lua     — Redis Lua EVAL (correct, dual write)
#   redis_atomic  — DECRBY plus compensating INCRBY (correct, leaks on crash)
#   go_chan       — one owner goroutine (correct in one process only)
#   token_queue   — local quota plus async order writer via Kafka (fastest, loosest)
RECIPE_FLASHSALE_ADAPTER=pg_cond
RECIPE_FLASHSALE_PORT=8081
